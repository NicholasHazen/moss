+#[test]
+fn births_recheck_parent_cells_instead_of_trusting_stale_contact_tokens() {
+    let mut course = birth_fixture();
+    course.world.resource_mut::<Clock>().tick = 1;
+    let mut preparation = Schedule::default();
+    preparation.add_systems(
+        (
+            supply::grow,
